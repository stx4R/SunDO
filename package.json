{
  "name": "sundo",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').promises.rm('dist',{recursive:true,force:true})\" && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "rules:test": "firebase emulators:exec --only firestore --project demo-sundo-rules \"node tests/rules/run.mjs\"",
    "rules:probe": "firebase emulators:exec --only firestore --project demo-sundo-rules \"node tests/rules/probe.mjs\"",
    "rules:mutate": "firebase emulators:exec --only firestore --project demo-sundo-rules \"node tests/rules/run.mjs\"",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "indexes:deploy": "firebase deploy --only firestore:indexes"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
